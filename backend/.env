# ── Database ──────────────────────────────────
# Default to SQLite local dev file, replace with Neon PostgreSQL string for production:
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/cultureflow?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./cultureflow.db

# ── Security ──────────────────────────────────
SECRET_KEY=cultureflow-dev-secret-key-change-in-production-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI ────────────────────────────────────────
GEMINI_API_KEY=

# ── OCR ───────────────────────────────────────
OCR_ENGINE=tesseract
TESSERACT_CMD=

# ── File Uploads ──────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://your-app.onrender.com

# ── App ───────────────────────────────────────
APP_NAME=CultureFlow
APP_ENV=development
DEBUG=true

# ── First Admin User ──────────────────────────
ADMIN_EMAIL=admin@cultureflow.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator
