# ─────────────────────────────────────────────
# CultureFlow Backend — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/cultureflow?sslmode=require

# ── Security ──────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-256-bit-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI ────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── OCR ───────────────────────────────────────
# Options: tesseract | paddleocr
OCR_ENGINE=tesseract
# Path to Tesseract binary (Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe)
# Leave blank on Linux/Mac (auto-detected)
TESSERACT_CMD=

# ── File Uploads ──────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://your-app.onrender.com

# ── App ───────────────────────────────────────
APP_NAME=CultureFlow
APP_ENV=development
DEBUG=true

# ── First Admin User (created on first startup) ─
ADMIN_EMAIL=admin@cultureflow.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator
